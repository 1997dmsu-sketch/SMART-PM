<view class="property-page">
  <view class="page-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="navigation">
      <button class="icon-button back" aria-label="返回" bindtap="back"><view class="back-chevron"></view></button>
      <text class="page-title">{{property.name || '房源信息'}}</text>

    </view>
    <view class="section-tabs">

      <view class="section-tab {{section === 'basic' ? 'active' : ''}}" data-section="basic" bindtap="changeSection">基础信息</view>
      <view class="section-tab {{section === 'rooms' ? 'active' : ''}}" data-section="rooms" bindtap="changeSection">房间信息</view>
      <view class="header-actions">
        <button class="icon-button" aria-label="编辑房源" data-title="编辑房源" bindtap="explainUnavailable"><image src="/assets/property-edit.png" /></button>
        <button class="icon-button" aria-label="删除房源" data-title="删除房源" bindtap="explainUnavailable"><image src="/assets/property-delete.png" /></button>
      </view>
    </view>
  </view>
  <view wx:if="{{demo}}" class="demo-label">设计演示 · 设备与房源为示例数据</view>
  <view class="page-body">
    <view wx:if="{{propertyLoading}}" class="property-status">正在加载房源…</view>
    <view wx:elif="{{propertyError}}" class="property-status error-text" bindtap="loadProperty">{{propertyError}} · 点击重试</view>
    <block wx:if="{{section === 'basic'}}">
      <view class="note-card">
        <view class="note-row" bindtap="toggleNote">
          <view><view class="note-title">房源备注</view><view class="note-caption">租客信息、押金、维修记录</view></view>
          <view class="note-expand">{{noteExpanded ? '收起备注' : '展开添加备注'}}<text class="chevron {{noteExpanded ? 'up' : ''}}"></text></view>
        </view>
        <view wx:if="{{noteExpanded}}" class="note-detail">
          <view class="existing-note">{{property.remark || '暂无房源备注'}}</view>
          <textarea class="note-editor" placeholder="填写本地备注草稿" value="{{noteDraft}}" maxlength="500" bindinput="editNote" />
          <view class="draft-hint">仅保存在本机，不会同步到物业后台。</view>
          <button class="draft-save" bindtap="saveNoteDraft">保存本地草稿</button>
          <text wx:if="{{noteSaved}}" class="saved-label">已保存到本机</text>
        </view>
      </view>
      <view class="quick-actions">
        <image class="actions-art" src="/assets/property-actions.png" mode="aspectFit" />
        <view class="action-hotspots"><button wx:for="{{actions}}" wx:key="id" class="action-hotspot" aria-label="{{item.label}}" data-id="{{item.id}}" data-label="{{item.label}}" bindtap="openAction"><text>{{item.label}}</text></button></view>
      </view>
      <view class="device-tabs"><view wx:for="{{deviceTabs}}" wx:key="id" class="device-tab {{deviceType === item.id ? 'active' : ''}}" data-type="{{item.id}}" bindtap="changeDeviceType">{{item.label}}</view></view>
      <view wx:if="{{loading}}" class="state-card">正在获取设备信息…</view>
      <view wx:elif="{{error}}" class="state-card"><view>{{error}}</view><button class="retry" bindtap="loadDevices">重试</button></view>
      <view wx:elif="{{!devices.length}}" class="state-card">暂无{{deviceType === 'water' ? '水表' : deviceType === 'locks' ? '门锁' : '电表'}}设备</view>
      <view wx:else class="device-list">
        <view wx:for="{{devices}}" wx:key="id" class="device-card">
          <view class="device-heading"><view class="device-icon"><image wx:if="{{deviceType === 'electricity'}}" src="/assets/property-meter.png" mode="aspectFit"/><text wx:else>{{deviceType === 'water' ? '水' : '锁'}}</text></view><view class="device-name-wrap"><view class="device-name">{{item.name}}<text wx:if="{{item.network}}" class="network-badge">{{item.network}}</text></view><view class="serial">{{item.serial || item.id}}</view></view></view>
          <view class="device-metrics">
            <view class="model-line"><text>{{deviceType === 'locks' ? '所在位置' : '设备名称'}}</text><text class="model-value">{{item.model || item.address || '待获取'}}</text></view>
            <view wx:if="{{deviceType !== 'locks'}}" class="metrics-row"><view class="metric"><view class="metric-caption">{{deviceType === 'water' ? '总用水量' : '总用电量'}}</view><view class="metric-value">{{item.usageText}}<text wx:if="{{item.usageText !== '待获取'}}">{{item.unit}}</text></view></view><view class="metric"><view class="metric-caption">{{deviceType === 'water' ? '水价' : '电价'}}</view><view class="metric-value">{{item.priceText}}<text wx:if="{{item.priceText !== '待获取'}}">元/{{item.unit}}</text></view></view><view class="metric"><view class="metric-caption">设备状态</view><view class="metric-value {{item.statusClass}}">{{item.statusText}}</view></view></view>
            <view wx:else class="lock-state">设备状态 <text class="{{item.statusClass}}">{{item.statusText}}</text></view>
          </view>
          <view class="updated">刷新时间 {{item.updatedAt || '暂无记录'}}</view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view wx:if="{{!propertyLoading && (!property || !property.rooms || !property.rooms.length)}}" class="state-card">暂无房间信息</view>
      <view wx:for="{{property.rooms}}" wx:key="id" class="room-card"><view class="room-title">{{item.name || item.houseId || '房间'}}</view><view class="room-caption">{{item.description || item.address || '暂无补充信息'}}</view></view>
    </block>
  </view>
  <view class="bottom-action"><button class="add-device" data-title="添加设备" bindtap="explainUnavailable">添加设备</button></view>
</view>
