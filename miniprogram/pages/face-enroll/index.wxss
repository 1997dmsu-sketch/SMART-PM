.face-page{box-sizing:border-box;width:100%;min-height:100vh;background:#f7f7f7;padding-bottom:calc(48rpx + env(safe-area-inset-bottom));color:#202124}
.face-page button{box-sizing:border-box;min-width:0;padding:0;margin:0;border:0;background:transparent;font-size:inherit;line-height:inherit;font-weight:normal;border-radius:0}
.face-page button::after{border:0}
.face-nav{position:relative;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:600}
.face-nav .nav-title{position:absolute;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.face-nav .nav-back{position:absolute;left:24rpx;top:0;height:100%;display:flex;align-items:center;font-size:56rpx;line-height:1;color:#333}
.test-badge-line{display:flex;align-items:center;gap:12rpx;padding:12rpx 28rpx 4rpx;flex-wrap:wrap}
.test-badge-line .test-scope{font-size:21rpx;line-height:1.5;color:#8a6a2f}
.info-card,.status-card,.upload-card{margin:20rpx 24rpx;background:#fff;border-radius:24rpx;padding:26rpx 24rpx}
.info-card .section-heading,.upload-card .section-heading{display:block;font-size:30rpx;font-weight:600;line-height:1.5;margin-bottom:16rpx}
.info-row{display:flex;align-items:flex-start;gap:16rpx;padding:14rpx 0;border-bottom:1rpx solid #f2f2f2;font-size:26rpx;line-height:1.6}
.info-row .info-label{flex:0 0 170rpx;color:#888}
.info-row .info-value{flex:1;min-width:0;color:#202124;word-break:break-all}
.info-row .room-no{font-size:36rpx;font-weight:700;color:#ff2450}
.info-row .readonly-tag{flex:0 0 auto;font-size:20rpx;line-height:1.5;color:#999;background:#f5f5f5;border-radius:16rpx;padding:2rpx 10rpx}
.status-card{display:flex;flex-direction:column;align-items:flex-start;gap:14rpx}
.status-card .status-hint{font-size:25rpx;line-height:1.7;color:#666}
.status-card .site-notice{display:block;width:100%;box-sizing:border-box;text-align:center;font-size:28rpx;font-weight:600;line-height:1.6;color:#18794e;background:#e9f7ef;border-radius:16rpx;padding:16rpx}
.status-card.state-site{background:#f2fbf6}
.status-card.state-failed{background:#fff7f7}
.status-card.state-unknown,.status-card.state-invalidated{background:#fffaf0}
.upload-card .consent-row{display:flex;align-items:flex-start;gap:14rpx;padding:6rpx 0 22rpx}
.upload-card .consent-text{flex:1;min-width:0;font-size:25rpx;line-height:1.7;color:#444}
.upload-card .upload-button{width:100%;background:#ff2450;color:#fff;border-radius:48rpx;padding:22rpx;font-size:30rpx;font-weight:600;line-height:1.5}
.upload-card .upload-note{display:block;font-size:22rpx;line-height:1.7;color:#999;margin-top:18rpx}
.upload-card .pending-config{margin-bottom:16rpx}
.uploaded-card .upload-note{margin-top:0}
.safety-note{display:block;margin:24rpx 40rpx;font-size:21rpx;line-height:1.7;color:#999}

/* 隐藏转码 canvas：移出可视区域，仅用于照片转 JPEG 压缩 */
.photo-canvas{position:fixed;left:-9999px;top:0;width:320px;height:320px;}
