.account-page{min-height:100vh;box-sizing:border-box;background:#f7f7f7;color:#222;padding-bottom:calc(30rpx + env(safe-area-inset-bottom))}.account-nav{position:relative;display:flex;align-items:center;justify-content:center;background:#fff}.nav-title{position:absolute;text-align:center;font-size:32rpx;font-weight:600}.account-page .back{position:absolute;left:12rpx;width:60rpx;padding:0;background:transparent;border:0;font-size:48rpx;line-height:1.2}.account-page .back::after{border:0}.account-card{margin:24rpx;padding:30rpx;background:#fff;border-radius:24rpx}.heading{display:block;font-size:32rpx;font-weight:600;margin-bottom:18rpx}.hint{display:block;font-size:24rpx;line-height:1.7;color:#777;margin:14rpx 0}.field-label{display:block;font-size:26rpx;margin:25rpx 0 12rpx}.text-input{height:88rpx;padding:0 20rpx;border:1rpx solid #ddd;border-radius:14rpx;font-size:28rpx}.account-page .primary{margin:28rpx 0 12rpx;padding:20rpx;font-size:28rpx;line-height:1.5;border-radius:40rpx}.account-page .primary{background:#ff2450;color:#fff}.account-page .primary[disabled]{opacity:.55}.error{margin:20rpx 0;color:#ad2544;font-size:25rpx;line-height:1.6}
