page{background:#f5f5f1;color:#202a27}.page{padding-bottom:50rpx}.nav{display:flex;align-items:center;background:#fff;min-height:88rpx;font-weight:600}.nav button{margin:0 20rpx;width:70rpx;padding:0;background:none;font-size:55rpx;line-height:70rpx}.nav button::after{border:0}.intro{padding:44rpx 34rpx 26rpx}.intro text{display:block}.eyebrow{font-size:23rpx;letter-spacing:4rpx;color:#527b68}.title{font-size:45rpx;font-weight:650;margin:14rpx 0 20rpx}.muted{color:#748078;font-size:25rpx;line-height:1.7;display:block}.card{background:white;margin:22rpx;padding:30rpx;border-radius:26rpx}.heading{display:block;font-size:31rpx;font-weight:600;margin-bottom:24rpx}.field{padding:26rpx 0;border-bottom:1rpx solid #edf0eb;display:flex;justify-content:space-between;gap:20rpx;font-size:27rpx}.field text{color:#52685b;max-width:77%}.input{font-size:28rpx;margin-top:26rpx;padding:18rpx 0}.primary,.secondary{border-radius:16rpx;font-size:28rpx;margin-top:25rpx}.primary{background:#2c5745;color:white}.secondary{background:#f1f5ef;color:#2c5745}.primary[disabled]{background:#cbd5ce;color:#748078}.record{padding:25rpx 0;border-top:1rpx solid #edf0eb}.record text{display:block;font-size:26rpx;line-height:1.8}.record-title{font-weight:600;font-size:29rpx!important}.amount{color:#a65b32;font-size:30rpx!important;font-weight:600;margin:12rpx 0}.buttons{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}.buttons button{font-size:23rpx;margin:0;padding:0 16rpx;background:#f1f5ef;color:#2c5745}.privacy{white-space:pre-wrap;font-size:25rpx;line-height:1.8;display:block;margin:20rpx 0}.consent{display:block;font-size:24rpx;line-height:1.8;margin:20rpx 0}.error{padding:24rpx;background:#fff0e7;color:#a64324;margin:20rpx;border-radius:15rpx;font-size:27rpx}.contract-mask{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:30;display:flex;align-items:flex-end}.contract-sheet{background:white;padding:32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));width:100%;border-radius:28rpx 28rpx 0 0;box-sizing:border-box}.contract-text{height:42vh;background:#f8f9f5;padding:20rpx;box-sizing:border-box;white-space:pre-wrap;font-size:26rpx;line-height:1.8}.policy{font-size:26rpx;color:#a64324;display:block;line-height:1.7}
