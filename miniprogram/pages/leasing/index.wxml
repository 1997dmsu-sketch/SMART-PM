<view class="page">
 <view class="nav" style="padding-top:{{statusBarHeight}}px"><button bindtap="back">‹</button><text>预约看房与预签约</text></view>
 <view class="intro"><text class="eyebrow">找到心仪的家</text><text class="title">先预约，再安心留房</text><text class="muted">选择户型和房号 · 预约看房 · 确认合同与押金</text></view>
 <view wx:if="{{!authenticated}}" class="card"><text>登录后提交预约，手机号用于物业联系。</text><button class="primary" open-type="getPhoneNumber" bindgetphonenumber="login" disabled="{{busy}}">手机号授权登录</button></view>
 <block wx:else>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="muted">正在加载…</view>
  <view class="card"><text class="heading">01 选择户型与房号</text>
   <block wx:if="{{layouts.length}}"><picker range="{{layouts}}" range-key="name" value="{{layoutIndex}}" bindchange="layoutChanged"><view class="field">户型 <text>{{layouts[layoutIndex].name}} ›</text></view></picker><picker range="{{roomOptions}}" range-key="label" value="{{roomIndex}}" bindchange="roomChanged"><view class="field">房号 <text>{{roomOptions[roomIndex].label}} ›</text></view></picker>
   <input class="input" placeholder="联系人姓名（用于预签约合同）" value="{{contactName}}" maxlength="40" bindinput="nameChanged"/><picker mode="date" start="{{today}}" value="{{visitDate}}" bindchange="dateChanged"><view class="field">看房日期 <text>{{visitDate || '请选择'}} ›</text></view></picker><picker mode="time" value="{{visitTime}}" bindchange="timeChanged"><view class="field">看房时间 <text>{{visitTime || '请选择'}} ›</text></view></picker><button class="primary" bindtap="submitAppointment" loading="{{busy}}" disabled="{{busy}}">提交看房预约</button></block>
   <text wx:else class="muted">暂无已上架且关联户型、房号的可预约房源，请联系物业。</text>
  </view>
  <view class="card"><text class="heading">02 我的看房预约</text><text wx:if="{{!appointments.length}}" class="muted">暂无预约记录</text>
   <view wx:for="{{appointments}}" wx:key="id" class="record"><text class="record-title">{{item.roomLabel}}</text><text>{{item.visitText}} · {{item.statusText}}</text><text class="muted">{{item.identityText}}</text><view wx:if="{{settings.enabled && identityReady && (item.status === 'submitted' || item.status === 'confirmed')}}" class="buttons"><button data-id="{{item.id}}" data-side="front" bindtap="uploadIdentity" disabled="{{uploading}}">{{item.identityFrontId ? '重传人像面' : '上传身份证人像面'}}</button><button data-id="{{item.id}}" data-side="back" bindtap="uploadIdentity" disabled="{{uploading}}">{{item.identityBackId ? '重传国徽面' : '上传身份证国徽面'}}</button></view><button wx:if="{{item.status === 'confirmed' && item.identityStatus === 'approved'}}" class="secondary" data-id="{{item.id}}" bindtap="quote" disabled="{{busy}}">查看预签约合同</button></view>
   <block wx:if="{{settings.enabled}}"><text class="privacy">{{settings.privacyText}}</text><checkbox-group bindchange="privacyChanged"><label class="consent"><checkbox value="agree" checked="{{privacyConsent}}"/>我已阅读并同意身份证收集说明</label></checkbox-group><text class="muted">请上传本人身份证正反面，材料加密保存，不展示在房源或普通日志中。审核通过后可确认预签约合同。</text></block>
  </view>
  <view class="card"><text class="heading">03 押金留房</text><text wx:if="{{!paymentReady}}" class="muted">物业正在开通微信支付，目前不能交押金留房。</text><text wx:if="{{!orders.length}}" class="muted">暂无预签约订单</text><view wx:for="{{orders}}" wx:key="id" class="record"><text class="record-title">{{item.roomLabel}}</text><text class="amount">押金 ¥{{item.depositText}}</text><text>{{item.statusText}}</text><text wx:if="{{item.untilText}}" class="muted">留房至 {{item.untilText}}</text><text wx:else class="muted">支付截止 {{item.deadlineText}}</text><view class="buttons"><button data-id="{{item.id}}" bindtap="viewContract">查看合同</button><button wx:if="{{item.status === 'awaiting_payment'}}" data-id="{{item.id}}" bindtap="pay" disabled="{{busy}}">交押金留房</button><button wx:if="{{item.status === 'awaiting_payment' || item.status === 'payment_expired' || item.status === 'paid_held'}}" data-id="{{item.id}}" bindtap="refreshPayment" disabled="{{busy}}">核对支付状态</button></view></view><button class="secondary" bindtap="load" disabled="{{loading}}">刷新我的记录</button></view>
 </block>
 <view wx:if="{{activeQuote || viewContract}}" class="contract-mask"><view class="contract-sheet"><text class="heading">预签约合同</text><scroll-view class="contract-text" scroll-y><text user-select>{{activeQuote.contractText || viewContract}}</text></scroll-view><block wx:if="{{activeQuote}}"><text class="amount">押金 ¥{{activeQuote.depositText}} · 付款后留房 {{activeQuote.holdHours}} 小时</text><text class="policy">{{activeQuote.expiryPolicy === 'non_refundable' ? '留房期限届满未完成正式签约，押金不退。请确认后再付款。' : '留房到期后由物业审核处理。'}}</text><checkbox-group bindchange="contractChanged"><label class="consent"><checkbox value="agree" checked="{{contractAccepted}}"/>我已阅读并同意合同、押金及留房规则</label></checkbox-group><button class="primary" bindtap="createOrder" disabled="{{busy || !contractAccepted || !paymentReady}}">确认合同并创建押金订单</button><text wx:if="{{!paymentReady}}" class="muted">微信支付尚未开通，暂不能创建押金订单。</text></block><button class="secondary" bindtap="closeContract">关闭</button></view></view>
</view>
