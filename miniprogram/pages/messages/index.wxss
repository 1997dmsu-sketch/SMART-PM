.messages-page{width:100%;min-height:100vh;box-sizing:border-box;background:#fff;padding-bottom:calc(152rpx + env(safe-area-inset-bottom));color:#151515}
.messages-page button{box-sizing:border-box;min-width:0;width:auto;margin:0;padding:0;border-radius:0;background:transparent;text-align:left;font-size:inherit;line-height:inherit;font-weight:normal}
.messages-page button::after{border:0}
.messages-nav{display:flex;align-items:center;position:relative}
.nav-title{position:absolute;text-align:center;font-size:34rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.message-tools{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:12rpx 28rpx;min-height:76rpx}
.messages-page .message-tools button.community{width:auto;flex:0 1 auto;max-width:calc(100% - 150rpx);display:flex;align-items:center;background:#f7f7f7;border-radius:32rpx;padding:10rpx 16rpx;font-size:23rpx;line-height:1.4;white-space:nowrap}
.community-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pin{flex-shrink:0;color:#ff2450;margin-right:8rpx}.dropdown{flex-shrink:0;margin-left:8rpx}
.messages-page .message-tools button.mark-read{width:auto;flex-shrink:0;min-height:64rpx;display:flex;align-items:center;font-size:24rpx;color:#666;white-space:nowrap}
.demo-label{font-size:21rpx;line-height:1.5;text-align:center;padding:8rpx 24rpx;background:#fff3f5;color:#b95a6c}
.notification-categories{position:relative;margin:20rpx 32rpx 28rpx}.notification-art{width:100%;display:block}.notification-targets{position:absolute;inset:0;display:flex}
.messages-page .notification-targets button.category-target{flex:1 1 0%;min-width:0;width:0;height:100%}.category-target:active{background:#ff24500a}
.messages-page button.conversation{width:100%;display:flex;align-items:center;min-height:134rpx;padding:22rpx 28rpx;border-bottom:1rpx solid #f2f2f2;border-radius:0}
.conversation:active{background:#f7f7f7}.conversation-avatar{height:88rpx;width:88rpx;flex-shrink:0;border-radius:50%;background:#f5f5f5;margin-right:22rpx}
.conversation-copy{min-width:0;display:flex;flex:1 1 0%;flex-direction:column;text-align:left;gap:10rpx}
.conversation-name{display:block;font-size:29rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.conversation-last{display:block;font-size:25rpx;line-height:1.5;color:#999;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.conversation-meta{flex:0 0 110rpx;min-width:0;max-width:110rpx;align-self:stretch;display:flex;flex-direction:column;align-items:flex-end;gap:16rpx;padding-left:12rpx;padding-top:5rpx}
.conversation-time{display:block;max-width:100%;font-size:22rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#999}
.unread-badge{min-width:28rpx;min-height:28rpx;border-radius:20rpx;background:#ff575b;color:#fff;font-size:22rpx;line-height:1.3;text-align:center;padding:0 5rpx}
.state-panel{display:flex;flex-direction:column;gap:18rpx;text-align:center;align-items:center;padding:70rpx 35rpx;color:#999;font-size:26rpx;overflow-wrap:break-word;word-break:break-all}
.empty-title{font-size:32rpx;color:#333}.error-panel button{padding:18rpx 35rpx;border-radius:40rpx;background:#fff0f3;color:#ff2450}
