    border: {style: solid, width: 3, color: "$sage"}
  - elementId: connector-gap
    elementType: line
    bounds: [490, 470, 160, 200]
    viewBox: [160, 200]
    points: "160,0 80,100 0,200"
    curve: smooth
    border: {style: solid, width: 3, color: "$amber"}
  - elementId: connector-core
    elementType: line
    bounds: [960, 162, 70, 228]
    viewBox: [70, 228]
    points: "0,228 34,112 70,0"
    curve: smooth
    border: {style: solid, width: 5, color: "$amber"}
  - elementId: connector-bottom-trunk
    elementType: line
    bounds: [785, 490, 10, 260]
    viewBox: [10, 260]
    points: "5,0 5,260"
    curve: sharp
    border: {style: solid, width: 3, color: "$sage"}
