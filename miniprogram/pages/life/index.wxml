<view class="life-page">
  <view class="life-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-row"><view wx:if="{{!searching}}" class="community-chip" bindtap="showCommunity"><view class="pin"></view><text>{{community}}</text><text class="chevron">▾</text></view><input wx:else class="search-input" value="{{keyword}}" placeholder="搜索小区、房源" focus="{{searching}}" bindinput="onSearch" confirm-type="search"/><view class="search-button" bindtap="toggleSearch" aria-label="{{searching ? '关闭搜索' : '搜索房源'}}"><text wx:if="{{searching}}" class="search-close">取消</text><view wx:else class="search-icon"></view></view></view>
    <scroll-view scroll-x class="services-scroll" show-scrollbar="{{false}}"><view class="service-row"><view wx:for="{{services}}" wx:key="id" class="service-item {{activeService === item.id ? 'service-active' : ''}}" data-id="{{item.id}}" bindtap="chooseService"><image class="service-icon" src="{{item.icon}}" mode="aspectFit"/><text>{{item.label}}</text></view></view></scroll-view>
    <view class="filter-row"><view class="filter-button {{filters.community ? 'filter-active' : ''}}" data-kind="area" bindtap="openFilter"><text>{{labels.area}}</text><text class="small-arrow">▾</text></view><view class="filter-button {{filters.price !== 'all' ? 'filter-active' : ''}}" data-kind="price" bindtap="openFilter"><text>{{labels.price}}</text><text class="small-arrow">▾</text></view><view class="filter-button {{filters.roomType ? 'filter-active' : ''}}" data-kind="room" bindtap="openFilter"><text>{{labels.room}}</text><text class="small-arrow">▾</text></view><view class="all-filter" data-kind="all" bindtap="openFilter">筛选<view class="filter-symbol"></view></view></view>
  </view>
  <view wx:if="{{isDemo}}" class="mode-hint">设计演示 · 房源仅供预览</view>
  <view wx:if="{{loading}}" class="state"><view class="loading-dot"></view><text>正在寻找理想的家…</text></view>
  <view wx:elif="{{error}}" class="state"><text>{{error}}</text><button class="retry" bindtap="loadHouses">重新加载</button></view>
  <view wx:elif="{{empty}}" class="state"><text class="empty-symbol">⌂</text><text>暂时没有符合条件的房源</text><button class="retry" bindtap="clearFilter">清除筛选</button></view>
  <view wx:else class="waterfall"><view class="waterfall-column" wx:for="{{columns}}" wx:key="index" wx:for-item="column"><view class="house-card" wx:for="{{column}}" wx:key="id" wx:for-item="house" data-id="{{house.id}}" bindtap="openHouse"><image wx:if="{{house.cover}}" class="house-image" src="{{house.cover}}" mode="aspectFill" style="height: {{house.imageHeight}}rpx;" lazy-load/><view wx:else class="image-placeholder" style="height: {{house.imageHeight}}rpx;">⌂</view><view class="house-body"><view class="house-title">{{house.title}}</view><view class="house-specs"><text wx:if="{{house.area}}">{{house.area}}㎡</text><text wx:if="{{house.rooms}}">/{{house.rooms}}</text><text wx:if="{{house.orientation}}">/{{house.orientation}}</text><text wx:if="{{house.rentType}}">/{{house.rentType}}</text></view><view class="house-price"><text>{{house.price}}</text><text wx:if="{{house.price !== '面议'}}" class="price-unit">元/月</text></view><view class="house-address" wx:if="{{house.address}}">地址：{{house.address}}</view><view class="tags" wx:if="{{house.tags.length}}"><text wx:for="{{house.tags}}" wx:key="*this" class="tag">{{item}}</text></view></view></view></view></view>
  <view wx:if="{{filterOpen}}" class="filter-mask" bindtap="closeFilter"><view class="filter-sheet" catchtap="stopTap"><view class="sheet-heading"><text>寻找理想的家</text><view class="sheet-close" bindtap="closeFilter">×</view></view><scroll-view scroll-y class="sheet-scroll">
    <view wx:if="{{filterKind === 'area' || filterKind === 'all'}}" class="option-section"><view class="section-title">小区</view><view class="options"><view wx:for="{{areas}}" wx:key="*this" class="option {{draft.community === item || (!draft.community &amp;&amp; item === '不限') ? 'option-selected' : ''}}" data-key="community" data-value="{{item}}" bindtap="chooseOption">{{item}}</view></view></view>
    <view wx:if="{{filterKind === 'price' || filterKind === 'all'}}" class="option-section"><view class="section-title">月租金</view><view class="options"><view wx:for="{{prices}}" wx:key="value" class="option {{draft.price === item.value ? 'option-selected' : ''}}" data-key="price" data-value="{{item.value}}" bindtap="chooseOption">{{item.label}}</view></view></view>
    <view wx:if="{{filterKind === 'room' || filterKind === 'all'}}" class="option-section"><view class="section-title">户型</view><view class="options"><view wx:for="{{rooms}}" wx:key="value" class="option {{draft.roomType === item.value ? 'option-selected' : ''}}" data-key="roomType" data-value="{{item.value}}" bindtap="chooseOption">{{item.label}}</view></view></view>
    <view wx:if="{{filterKind === 'all'}}" class="option-section"><view class="section-title">租赁方式</view><view class="options"><view wx:for="{{rents}}" wx:key="value" class="option {{draft.rentType === item.value ? 'option-selected' : ''}}" data-key="rentType" data-value="{{item.value}}" bindtap="chooseOption">{{item.label}}</view></view></view>
  </scroll-view><view class="sheet-actions"><button class="reset-button" bindtap="resetFilter">重置</button><button class="apply-button" bindtap="applyFilter">查看房源</button></view></view></view>
</view>
