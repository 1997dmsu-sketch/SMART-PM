{
  "name": "smart-pm",
  "version": "0.1.0-beta.11",
  "private": true,
  "description": "宇宙物业智联小程序",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check-miniprogram.mjs",
    "verify:backend": "node scripts/verify-import.mjs",
    "setup:backend": "node scripts/install-backend.mjs",
    "release:package": "python3 scripts/package-release.py",
    "release:live": "python3 scripts/package-release.py --live",
    "version:sync": "node scripts/sync-version.mjs",
    "admin": "node admin-web/server.mjs",
    "test:admin": "npm --prefix admin-web test"
  },
  "engines": {
    "node": ">=20"
  }
}
