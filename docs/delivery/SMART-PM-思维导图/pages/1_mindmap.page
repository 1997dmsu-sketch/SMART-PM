      text: 统一确认规则 · 核心业务流程 · 交付顺序 · 当前边界
  - elementId: legend-core-line
    elementType: line
    bounds: [1110, 48, 34, 4]
    viewBox: [34, 4]
    points: "0,2 34,2"
    border: {style: solid, width: 4, color: "$amber"}
  - elementId: legend-core-text
    elementType: text
    bounds: [1154, 37, 140, 26]
    content: {fontSize: 12, color: "$ink", wrap: false, align: [left, middle], text: 核心／待补证据}
  - elementId: legend-main-line
