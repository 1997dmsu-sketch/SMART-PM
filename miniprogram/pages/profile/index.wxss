.profile-page{box-sizing:border-box;min-height:100vh;background:linear-gradient(155deg,#ffe2e7 0,#fff0f1 350rpx,#f7f7f7 620rpx);padding-bottom:calc(145rpx + env(safe-area-inset-bottom));color:#131313}.profile-page button{padding:0;margin:0;border:0;background:transparent;font-size:inherit;line-height:inherit;font-weight:normal;border-radius:0}.profile-page button::after{border:0}.profile-nav{height:110rpx;position:relative;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:600}.profile-nav button{position:absolute;left:34rpx;top:32rpx;width:44rpx;height:44rpx}.profile-nav image{width:40rpx;height:40rpx}.demo-label{font-size:21rpx;text-align:center;color:#b95a6c;padding:8rpx 0}.identity{display:flex;align-items:center;padding:24rpx 30rpx 16rpx;position:relative;min-height:120rpx}.avatar{width:116rpx;height:116rpx;flex-shrink:0;border-radius:50%;background:white;margin-right:20rpx}.identity-copy{min-width:0;flex:1}.identity-name{display:flex;gap:14rpx;align-items:center;font-size:34rpx;font-weight:600}.identity-name>text:first-child{max-width:250rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.owner-badge{font-size:22rpx;font-weight:normal;border-radius:24rpx;padding:3rpx 10rpx;background:#ff5c63;color:#fff}.property-id{display:block;font-size:25rpx;color:#666;margin-top:8rpx}.identity-address{display:flex;gap:10rpx;margin-top:8rpx;color:#666;font-size:23rpx;flex-wrap:wrap;padding-right:90rpx}.community-label{color:#a94b50;background:#fff;border-radius:20rpx;padding:0 8rpx}.edit-profile{position:absolute;right:30rpx;top:65rpx;background:#fff!important;border-radius:40rpx!important;padding:10rpx 18rpx!important;color:#777;font-size:22rpx!important}.login-hint{display:block;color:#999;font-size:23rpx;margin-top:16rpx}.login-button{margin:20rpx 50rpx 0!important;padding:20rpx!important;background:#ff2450!important;color:white;border-radius:40rpx!important;font-size:28rpx!important}.profile-stats{display:flex;padding:22rpx 0 32rpx}.profile-stats button{flex:1;display:flex;flex-direction:column;align-items:center;gap:14rpx;font-size:25rpx}.stat-value{font-size:38rpx;font-weight:700}.service-card,.menu-card{background:#fff;border-radius:32rpx;margin:0 30rpx 30rpx;padding:28rpx 30rpx}.section-heading{font-size:30rpx;font-weight:600;display:block;margin-bottom:28rpx}.service-grid{display:flex;justify-content:space-between;padding:5rpx 0 12rpx}.service-grid button{display:flex;flex-direction:column;align-items:center;gap:18rpx;flex:1;font-size:25rpx}.service-grid image{width:80rpx;height:80rpx}.menu-card{padding-bottom:0}.menu-card .section-heading{margin-bottom:0}.menu-row{display:flex;align-items:center;width:100%;height:108rpx;text-align:left;border-bottom:1rpx solid #f0f0f0!important;font-size:28rpx!important}.menu-row:last-child{border-bottom:0!important}.menu-row image{width:40rpx;height:40rpx;margin:0 18rpx 0 6rpx}.chevron{margin-left:auto;font-size:48rpx;color:#888;line-height:1}.error-panel{margin:20rpx 30rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:white;padding:20rpx;border-radius:20rpx;font-size:24rpx;color:#a74a5c}.error-panel button{color:#ff2450;white-space:nowrap}.modal-mask{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.45);display:flex;align-items:flex-end}.favorites-sheet{width:100%;box-sizing:border-box;padding:30rpx 32rpx calc(35rpx + env(safe-area-inset-bottom));background:white;border-radius:28rpx 28rpx 0 0}.favorites-title{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:600}.favorites-title button{font-size:44rpx;width:60rpx}.empty-favorites{display:block;padding:70rpx 20rpx;text-align:center;color:#999;font-size:26rpx}.favorites-list{max-height:600rpx;margin:20rpx 0}.favorites-list button{padding:24rpx 4rpx;border-bottom:1rpx solid #eee;text-align:left;font-size:28rpx;display:flex;justify-content:space-between}.local-note{display:block;color:#999;font-size:22rpx;text-align:center;margin-top:18rpx}
