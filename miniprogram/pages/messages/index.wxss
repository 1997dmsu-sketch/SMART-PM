.messages-page{min-height:100vh;box-sizing:border-box;background:#fff;padding-bottom:calc(140rpx + env(safe-area-inset-bottom));color:#151515}.messages-page button{margin:0;padding:0;border-radius:0;background:transparent;text-align:left;font-size:inherit;line-height:inherit;font-weight:normal}.messages-page button::after{border:0}.messages-nav{height:112rpx;display:flex;align-items:center;justify-content:space-between;padding:0 24rpx;border-bottom:1rpx solid #ededed;position:relative}.community{display:flex!important;align-items:center;background:#f7f7f7!important;border-radius:40rpx!important;padding:10rpx 12rpx!important;font-size:22rpx!important;max-width:260rpx;white-space:nowrap}.pin{font-size:22rpx;color:#ff2450;margin-right:8rpx}.dropdown{margin-left:6rpx}.nav-title{position:absolute;left:50%;transform:translateX(-50%);font-size:36rpx;font-weight:600}.mark-read{font-size:26rpx!important;padding:18rpx 0 18rpx 12rpx!important}.demo-label{font-size:21rpx;text-align:center;padding:10rpx;background:#fff3f5;color:#b95a6c}.notification-categories{position:relative;margin:12rpx 48rpx 45rpx}.notification-art{width:100%;display:block}.notification-targets{position:absolute;inset:0;display:flex}.category-target{flex:1;height:100%}.category-target:active{background:#ff24500a!important}.conversation{width:100%;display:flex!important;align-items:center;min-height:134rpx!important;box-sizing:border-box;padding:22rpx 30rpx!important;border-bottom:1rpx solid #f2f2f2!important}.conversation:active{background:#f7f7f7!important}.conversation-avatar{height:88rpx;width:88rpx;flex-shrink:0;border-radius:50%;background:#f5f5f5;margin-right:24rpx}.conversation-copy{min-width:0;display:flex;flex:1;flex-direction:column;text-align:left;gap:10rpx}.conversation-name{font-size:29rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.conversation-last{font-size:25rpx;line-height:1.5;color:#999;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.conversation-meta{align-self:stretch;display:flex;flex-direction:column;align-items:flex-end;gap:16rpx;padding-left:12rpx;min-width:66rpx;padding-top:5rpx}.conversation-time{font-size:22rpx;white-space:nowrap;color:#999}.unread-badge{min-width:28rpx;height:28rpx;border-radius:20rpx;background:#ff575b;color:#fff;font-size:22rpx;line-height:28rpx;text-align:center;padding:0 4rpx}.state-panel{display:flex;flex-direction:column;gap:18rpx;text-align:center;align-items:center;padding:70rpx 35rpx;color:#999;font-size:26rpx}.empty-title{font-size:32rpx;color:#333}.error-panel button{padding:18rpx 35rpx!important;border-radius:40rpx!important;background:#fff0f3!important;color:#ff2450}

/* Keep the native WeChat capsule area free of custom controls. */
.message-tools{display:flex;justify-content:flex-end;padding:0 30rpx;min-height:52rpx}.message-tools .mark-read{font-size:24rpx!important;padding:12rpx 0!important;color:#666}
