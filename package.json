{
  "name": "smart-pm",
  "version": "0.1.0-beta.19-checkin-face.3",
  "private": true,
  "description": "宇宙物业智联小程序",
  "scripts": {
    "test": "node --require ./tests/support/d-network-guard.cjs --test tests/*.test.cjs",
    "check": "node scripts/check-miniprogram.mjs",
    "check:checkin-face": "node scripts/checkin-face-static-check.mjs && node scripts/verify-checkin-face-sources.mjs",
    "check:checkin-face:sources": "node scripts/verify-checkin-face-sources.mjs",
    "verify:backend": "node scripts/verify-import.mjs",
    "setup:backend": "node scripts/install-backend.mjs",
    "release:package": "python3 scripts/package-release.py",
    "release:live": "python3 scripts/package-release.py --live",
    "version:sync": "node scripts/sync-version.mjs",
    "admin": "node admin-web/server.mjs",
    "test:admin": "npm --prefix admin-web test",
    "worker:checkin-face": "node tools/checkin-face-worker/claim-and-enroll.mjs",
    "release:checkin-face": "python scripts/package-release.py --live --checkin-face",
    "admin:qishanyuan": "node admin-web/qishanyuan-demo.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
