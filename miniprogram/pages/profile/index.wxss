.profile-page{box-sizing:border-box;width:100%;min-height:100vh;background:linear-gradient(155deg,#ffe2e7 0,#fff0f1 350rpx,#f7f7f7 620rpx);padding-bottom:calc(152rpx + env(safe-area-inset-bottom));color:#131313}
.profile-page button{box-sizing:border-box;min-width:0;width:auto;padding:0;margin:0;border:0;background:transparent;font-size:inherit;line-height:inherit;font-weight:normal;border-radius:0}.profile-page button::after{border:0}
.profile-nav{position:relative;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:600}.profile-nav .nav-title{position:absolute;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.profile-page .profile-nav button{position:absolute;left:16rpx;top:0;width:44px;height:100%;display:flex;align-items:center;justify-content:center}.profile-nav image{width:40rpx;height:40rpx}
.demo-label{font-size:21rpx;line-height:1.5;text-align:center;color:#b95a6c;padding:8rpx 24rpx}
.identity{display:flex;align-items:center;gap:18rpx;padding:24rpx 28rpx 16rpx;min-height:120rpx}.avatar{width:108rpx;height:108rpx;flex-shrink:0;border-radius:50%;background:white}.identity-copy{min-width:0;flex:1 1 0%}
.identity-name{display:flex;gap:10rpx;align-items:center;flex-wrap:wrap;font-size:32rpx;font-weight:600}.nickname{min-width:0;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.owner-badge{flex-shrink:0;font-size:21rpx;line-height:1.5;font-weight:normal;border-radius:24rpx;padding:3rpx 10rpx;background:#ff5c63;color:#fff}
.property-id{display:block;font-size:24rpx;line-height:1.5;color:#666;margin-top:8rpx;overflow-wrap:break-word;word-break:break-all}
.identity-address{display:flex;gap:8rpx;margin-top:8rpx;color:#666;font-size:23rpx;line-height:1.5;flex-wrap:wrap}.community-label{max-width:100%;color:#a94b50;background:#fff;border-radius:20rpx;padding:0 8rpx;word-break:break-all}.house-address{max-width:100%;word-break:break-all}
.profile-page .identity button.edit-profile{width:auto;position:static;flex:0 0 auto;align-self:center;background:#fff;border-radius:32rpx;padding:12rpx 14rpx;color:#777;font-size:22rpx;line-height:1.5;white-space:nowrap}
.login-hint{display:block;color:#999;font-size:23rpx;line-height:1.5;margin-top:16rpx}.profile-page .login-button{margin:20rpx 28rpx 0;padding:20rpx;background:#ff2450;color:white;border-radius:40rpx;font-size:28rpx}
.profile-stats{display:flex;padding:22rpx 20rpx 32rpx;gap:8rpx}.profile-page .profile-stats button{flex:1 1 0%;width:0;min-width:0;display:flex;flex-direction:column;align-items:center;gap:14rpx;font-size:25rpx;line-height:1.5;text-align:center;word-break:break-all}.stat-value{font-size:38rpx;font-weight:700;max-width:100%}
.service-card,.menu-card{background:#fff;border-radius:28rpx;margin:0 24rpx 24rpx;padding:28rpx 24rpx;min-width:0}.section-heading{font-size:30rpx;line-height:1.5;font-weight:600;display:block;margin-bottom:24rpx}
.service-grid{display:flex;padding:5rpx 0 12rpx;gap:12rpx}.profile-page .service-grid button{display:flex;flex-direction:column;align-items:center;gap:16rpx;flex:1 1 0%;width:0;min-width:0;font-size:25rpx;line-height:1.5;text-align:center;white-space:normal;word-break:break-all}.service-grid image{width:80rpx;height:80rpx;flex-shrink:0}.service-grid text{max-width:100%}
.menu-card{padding-bottom:0}.menu-card .section-heading{margin-bottom:0}.profile-page .menu-card button.menu-row{display:flex;align-items:center;width:100%;min-height:108rpx;padding:22rpx 0;text-align:left;border-bottom:1rpx solid #f0f0f0;font-size:28rpx;line-height:1.5;gap:18rpx}.menu-row:last-child{border-bottom:0}.menu-row image{width:40rpx;height:40rpx;flex-shrink:0;margin-left:6rpx}.menu-row>text:not(.chevron){min-width:0;flex:1;word-break:break-all}.chevron{margin-left:auto;flex-shrink:0;font-size:42rpx;color:#888;line-height:1}
.error-panel{margin:20rpx 24rpx;display:flex;align-items:center;gap:20rpx;background:white;padding:20rpx;border-radius:20rpx;font-size:24rpx;color:#a74a5c}.error-panel>text{flex:1;min-width:0;word-break:break-all}.error-panel button{flex-shrink:0;color:#ff2450;white-space:nowrap}
.modal-mask{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.45);display:flex;align-items:flex-end}.favorites-sheet{width:100%;max-height:calc(100vh - 100px);box-sizing:border-box;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));background:white;border-radius:28rpx 28rpx 0 0;display:flex;flex-direction:column}
.favorites-title{display:flex;flex-shrink:0;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:600;gap:20rpx}.favorites-title button{flex-shrink:0;font-size:44rpx;width:60rpx}.empty-favorites{display:block;padding:50rpx 12rpx;text-align:center;color:#999;font-size:26rpx;line-height:1.6}
.favorites-list{height:50vh;max-height:600rpx;min-height:0;margin:20rpx 0;flex-shrink:1}.profile-page .favorites-list button{width:100%;padding:24rpx 4rpx;border-bottom:1rpx solid #eee;text-align:left;font-size:28rpx;line-height:1.5;display:flex;justify-content:space-between;gap:20rpx}.favorite-name{flex:1;min-width:0;word-break:break-all}.favorite-arrow{flex-shrink:0}.local-note{display:block;flex-shrink:0;color:#999;font-size:22rpx;text-align:center;margin-top:18rpx}.release-info{text-align:center;font-size:23rpx;color:#999;padding:28rpx 0 10rpx}
@media (max-width:350px){.identity{flex-wrap:wrap}.identity-copy{flex-basis:calc(100% - 140rpx)}.profile-page .identity button.edit-profile{width:auto;margin-left:auto}.service-card,.menu-card{margin-left:20rpx;margin-right:20rpx}}
