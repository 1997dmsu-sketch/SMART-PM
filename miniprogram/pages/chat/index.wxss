.chat{padding-bottom:calc(150rpx + env(safe-area-inset-bottom));min-height:100vh}.nav{height:88rpx;display:flex;align-items:center;padding:0 210rpx 0 24rpx;background:#fff;gap:32rpx;font-weight:600}.nav button{padding:0;background:none;margin:0;font-size:58rpx;width:50rpx;line-height:1}.nav text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.message{padding:20rpx 28rpx;display:flex;flex-direction:column;align-items:flex-start}.time{align-self:center;font-size:22rpx;color:#aaa;margin-bottom:20rpx}.bubble{max-width:80%;background:#fff;border-radius:20rpx;padding:24rpx;line-height:1.7;word-break:break-all}.mine{align-items:flex-end}.mine .bubble{background:#ffe5eb}.composer{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;gap:16rpx;align-items:center}.composer input{flex:1;min-width:0;border-radius:16rpx;background:#f5f5f5;padding:20rpx;height:80rpx}.composer button{background:#ff2450;color:#fff;border-radius:38rpx;margin:0;padding:15rpx 30rpx}.more{font-size:24rpx;background:none;color:#999}
