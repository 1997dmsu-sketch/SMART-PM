<view wx:if="{{!modalOpen}}" class="tab-bar"><view wx:for="{{tabs}}" wx:key="key" class="tab {{selected === item.key ? 'active' : ''}} {{item.key === 'unlock' ? 'door-tab' : ''}}" data-key="{{item.key}}" bindtap="switchTab" role="button" aria-label="{{item.label}}"><view wx:if="{{item.key === 'unlock'}}" class="door"><image src="/assets/door.png" mode="aspectFit"/></view><text wx:else>{{item.label}}</text></view></view>
