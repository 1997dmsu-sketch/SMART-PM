    bounds: [1015, 750, 10, 40]
    viewBox: [10, 40]
    points: "5,0 5,40"
    border: {style: solid, width: 3, color: "$sage"}
  - elementId: connector-bottom-m5
    elementType: line
    bounds: [1375, 750, 10, 40]
    viewBox: [10, 40]
    points: "5,0 5,40"
    border: {style: dash, width: 2, color: "$muted"}

  # 根节点
  - elementId: root-shape
    elementType: shape
    bounds: [620, 350, 340, 140]
    shapeName: ellipse
    fill: {type: solid, color: "$forest"}
    shadow: {blur: 12, color: "#173F3526", offset: [0, 5]}
  - elementId: root-title
    elementType: text
    bounds: [660, 378, 260, 62]
    content:
      fontSize: 26
      bold: true
      color: "$white"
      lineHeight: 1.15
      align: [center, middle]
      text: |
        SMART-PM
        需求与交付总览
  - elementId: root-subtitle
    elementType: text
    bounds: [660, 445, 260, 20]
    content:
      fontSize: 12
      color: "#DCE7E1"
      wrap: false
      align: [center, middle]
      text: 七份分册 · 确认／实现／验收分列

  # M1：账号与身份
  - elementId: m1-tick
    elementType: line
    bounds: [48, 137, 5, 28]
    viewBox: [5, 28]
    points: "2.5,0 2.5,28"
    border: {style: solid, width: 5, color: "$sage"}
  - elementId: m1-title
    elementType: text
    bounds: [68, 132, 340, 36]
    content:
      style: "$branch"
      wrap: false
      align: [left, middle]
      text: M1｜无码注册与账号
  - elementId: m1-priority
    elementType: text
    bounds: [420, 137, 58, 24]
    content: {fontSize: 12, bold: true, color: "$sage", align: [right, middle], text: P0 先行}
  - elementId: m1-body
    elementType: text
    bounds: [68, 180, 390, 126]
    content:
      style: "$body"
      align: [left, top]
      text: |
        取消开户码；手机号经服务端核验后自动注册／复用
        管理员为已注册住户开通密码；住户密码最低 8 位
        注册不自动授房或门禁；指定测试账号尚未创建

  # M2：房源与预约
  - elementId: m2-tick
    elementType: line
    bounds: [48, 352, 5, 28]
    viewBox: [5, 28]
    points: "2.5,0 2.5,28"
