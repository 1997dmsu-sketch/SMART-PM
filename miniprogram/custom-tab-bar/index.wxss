.tab-bar{position:fixed;z-index:80;bottom:0;left:0;right:0;display:flex;align-items:center;height:112rpx;padding-bottom:env(safe-area-inset-bottom);box-sizing:content-box;background:#fff;box-shadow:0 -2rpx 12rpx rgba(0,0,0,.025)}.tab{flex:1;text-align:center;color:#888;font-size:28rpx;padding:26rpx 0}.active{color:#111;font-weight:600}.door-tab{position:relative;height:112rpx;padding:0}.door{position:absolute;width:112rpx;height:112rpx;border-radius:50%;background:#ff2450;left:50%;top:-28rpx;transform:translateX(-50%);border:8rpx solid #fff;display:flex;align-items:center;justify-content:center}.door image{width:80rpx;height:80rpx}
