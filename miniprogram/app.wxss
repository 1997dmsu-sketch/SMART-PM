page{background:#f7f7f7;color:#202124;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;box-sizing:border-box}view,button,input,textarea{box-sizing:border-box}button{font-size:28rpx;line-height:1.5}button::after{border:none}button[disabled]{opacity:.5}image{display:block} .demo-notice{background:#fff4f5;color:#a94757;font-size:21rpx;padding:10rpx 24rpx;text-align:center}.empty-state,.error-state{padding:70rpx 30rpx;text-align:center;color:#888}.error-state{color:#aa4658}.primary-button{background:#ff2450;color:white;border-radius:48rpx;padding:20rpx}.safe-bottom{height:env(safe-area-inset-bottom)}
