.home-page{min-height:100vh;background:#f7f7f7;padding-bottom:180rpx;color:#171717}.home-header{background:#fff}.top-row{height:88rpx;padding:0 200rpx 0 18rpx;display:flex;align-items:center;justify-content:space-between}.community-chip{min-width:0;display:flex;align-items:center;gap:10rpx;background:#f7f7f7;border-radius:40rpx;padding:9rpx 16rpx;font-size:32rpx;max-width:550rpx}.community-chip>text:first-of-type{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chevron{font-size:22rpx}.pin{width:23rpx;height:29rpx;background:#ff2450;border-radius:50% 50% 50% 0;transform:rotate(-45deg);position:relative;margin-right:4rpx}.pin::after{content:'';position:absolute;top:7rpx;left:7rpx;width:9rpx;height:9rpx;background:white;border-radius:50%}.search-button{flex-shrink:0;width:65rpx;height:70rpx;display:flex;align-items:center;justify-content:center}.search-icon{width:30rpx;height:30rpx;border:4rpx solid #383838;border-radius:50%;position:relative}.search-icon::after{content:'';position:absolute;bottom:-12rpx;right:-9rpx;width:18rpx;height:4rpx;transform:rotate(50deg);background:#383838}.search-input{min-width:0;flex:1;background:#f7f7f7;padding:14rpx 24rpx;border-radius:36rpx;margin-right:16rpx;font-size:28rpx}.search-close{font-size:26rpx;white-space:nowrap}.feed-tabs{height:76rpx;border-top:1rpx solid #f2f2f2;display:flex}.feed-tab{width:50%;height:76rpx;position:relative;display:flex;align-items:center;justify-content:center;font-size:36rpx;color:#888}.feed-tab.selected{color:#111;font-weight:500}.tab-line{position:absolute;bottom:9rpx;width:54rpx;height:5rpx;border-radius:4rpx;background:#ff2450}.mode-hint{padding:8rpx;text-align:center;font-size:20rpx;color:#ad7883;background:#fff4f6}.waterfall{display:flex;align-items:flex-start;gap:14rpx;padding:8rpx 18rpx 24rpx}.waterfall-column{width:calc((100% - 14rpx)/2);min-width:0}.post-card{background:#fff;border-radius:20rpx;overflow:hidden;margin-bottom:14rpx;box-shadow:0 6rpx 20rpx #00000004}.post-image{display:block;width:100%}.post-body{padding:15rpx 20rpx 18rpx}.post-title{font-size:30rpx;font-weight:600;line-height:1.5;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.tags{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:12rpx}.tag{background:#fff5f4;color:#d85b5b;font-size:21rpx;padding:4rpx 7rpx;border-radius:4rpx;white-space:nowrap}.post-footer{display:flex;align-items:center;margin-top:15rpx;gap:8rpx;min-height:36rpx}.avatar{width:29rpx;height:29rpx;border-radius:50%;flex-shrink:0}.author{font-size:23rpx;color:#999;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;flex:1}.like-button{display:flex;align-items:center;gap:4rpx;flex-shrink:0}.heart{color:#888;font-size:36rpx;line-height:1}.liked .heart{color:#ff2450}.like-count{font-size:23rpx;color:#999}.image-placeholder{display:flex;flex-direction:column;justify-content:center;align-items:center;background:linear-gradient(145deg,#f1e9dc,#e8ded0);color:#a5917b;font-size:24rpx;gap:16rpx}.placeholder-house{font-size:100rpx;font-weight:200}.state{padding:160rpx 45rpx;display:flex;flex-direction:column;align-items:center;gap:20rpx;font-size:28rpx;text-align:center;color:#888}.state-note{font-size:24rpx;color:#aaa;line-height:1.8}.empty-symbol{font-size:90rpx;color:#f1a8b7}.retry{background:#ff2450;color:white;font-size:27rpx;border-radius:40rpx;padding:0 38rpx;margin-top:12rpx}.retry::after,.detail-button::after{border:0}.loading-dot{height:18rpx;width:18rpx;background:#ff2450;border-radius:50%;animation:pulse 1s infinite alternate}@keyframes pulse{to{opacity:.25}}.post-mask{position:fixed;inset:0;background:#0007;z-index:2000;display:flex;align-items:center;justify-content:center;padding:48rpx}.post-detail{width:100%;max-height:80vh;background:#fff;border-radius:28rpx;padding:30rpx;box-sizing:border-box;overflow-y:auto;position:relative}.detail-close{position:absolute;top:12rpx;right:20rpx;background:#ffffffdd;border-radius:50%;width:60rpx;height:60rpx;line-height:55rpx;text-align:center;font-size:44rpx;z-index:1}.detail-image{width:100%;height:440rpx;border-radius:16rpx}.detail-title{font-size:34rpx;line-height:1.5;font-weight:600;margin:20rpx 0 12rpx}.detail-author{font-size:24rpx;color:#999;display:block}.detail-description{display:block;font-size:28rpx;line-height:1.8;margin:20rpx 0;white-space:pre-wrap}.detail-button{background:#fff0f3;color:#ff2450;border-radius:50rpx;font-size:28rpx}
